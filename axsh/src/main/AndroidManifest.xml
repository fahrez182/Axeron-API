<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- AxShellService: its processes hand their binder in here (it checks their uid), and it
             keeps the app's Context for AxShellService.bind. -->
        <provider
            android:name="frb.axeron.shell.ShellServiceProvider"
            android:authorities="${applicationId}.shellservice"
            android:exported="true" />
    </application>

</manifest>
